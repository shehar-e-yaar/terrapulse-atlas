# Optional browser-visible Amazon Location key. Restrict actions, origin, expiry.
# Never put AWS secret keys or LLM provider secrets in VITE_ variables.
VITE_AWS_REGION=ap-south-1
VITE_AWS_LOCATION_API_KEY=
# Public CORS-enabled S3/CloudFront URL returning the documented GeoJSON schema.
VITE_SPATIAL_DATA_URL=
# Optional protected HTTPS summarization endpoint (see server/README.md).
VITE_AGENT_ENDPOINT=
